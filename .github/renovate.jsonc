{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>kachick/renovate-config//presets/default.jsonc",
    "github>kachick/renovate-config//presets/bundler.jsonc"
  ],
  "packageRules": [
    // Do not let Renovate update dependencies in gemfiles/oldest because it pins
    // minimum supported versions for CI compatibility tests
    {
      "description": "Disable updates in gemfiles/oldest used for minimum version testing",
      "matchFileNames": [
        "gemfiles/oldest/**"
      ],
      "enabled": false
    },
    // Do not casually bump runtime dependencies in gemspec to preserve minimum supported versions
    {
      "description": "Disable casual updates in gemspec to preserve minimum supported versions",
      "matchFileNames": [
        "**/*.gemspec"
      ],
      "enabled": false
    }
  ]
}
